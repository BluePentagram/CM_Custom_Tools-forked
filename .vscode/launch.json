{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Run",
            "type": "node", // VSC doesn't have a `shell` type, use built in `node` type instead
            "request": "launch",
            "cwd": "${workspaceFolder}/../../",
            "console": "internalConsole",
            "internalConsoleOptions":"neverOpen",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/../../RimWorldWin64.exe",
                "preLaunchTask": "build",
            },
            "linux": {
                // https://github.com/pardeike/Rimworld-Doorstop?tab=readme-ov-file#quick-start--linux-with-rider
                "runtimeExecutable": "sh",
                "runtimeArgs": [ 
                    "-c", "if [ -f ./run.sh ]; then ./run.sh; else ./RimWorldLinux; fi"
                ],
                "preLaunchTask": "build",
            }
        },  
    ],
    "compounds": [
        {
            "name": "Build & Debug",
            "configurations": [
                "Build & Run"
            ],
            "stopAll": true
        },
    ],
}